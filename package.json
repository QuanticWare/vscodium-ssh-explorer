{
  "name": "vscodium-ssh-explorer",
  "displayName": "SSH Explorer",
  "description": "%extension.description%",
  "version": "0.2.2",
  "publisher": "anita",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.quanticware.com/anita/vscodium-ssh-explorer.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ssh",
    "sftp",
    "remote",
    "vscodium",
    "explorer"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onFileSystem:ssh"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sshExplorer.connect",
        "title": "%command.connect.title%",
        "icon": "$(plug)"
      },
      {
        "command": "sshExplorer.openFolder",
        "title": "%command.openFolder.title%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sshExplorer.openParent",
        "title": "%command.openParent.title%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sshExplorer.disconnect",
        "title": "%command.disconnect.title%",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "sshExplorer.refreshHosts",
        "title": "%command.refreshHosts.title%",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sshExplorer",
          "title": "SSH Explorer",
          "icon": "resources/ssh.svg"
        }
      ]
    },
    "views": {
      "sshExplorer": [
        {
          "id": "sshExplorerHosts",
          "name": "%view.hosts.name%",
          "icon": "resources/ssh.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sshExplorer.refreshHosts",
          "when": "view == sshExplorerHosts",
          "group": "navigation"
        },
        {
          "command": "sshExplorer.connect",
          "when": "view == sshExplorerHosts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sshExplorer.openFolder",
          "when": "view == sshExplorerHosts && viewItem == sshHost",
          "group": "inline"
        }
      ],
      "explorer/context": [
        {
          "command": "sshExplorer.openParent",
          "when": "explorerResourceIsFolder && resourceScheme == ssh",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "SSH Explorer",
      "properties": {
        "sshExplorer.configPath": {
          "type": "string",
          "default": "~/.ssh/config",
          "description": "%config.configPath.description%"
        },
        "sshExplorer.defaultRemotePath": {
          "type": "string",
          "default": ".",
          "description": "%config.defaultRemotePath.description%"
        },
        "sshExplorer.connectTimeout": {
          "type": "number",
          "default": 20000,
          "description": "%config.connectTimeout.description%"
        },
        "sshExplorer.keepaliveInterval": {
          "type": "number",
          "default": 15000,
          "description": "%config.keepaliveInterval.description%"
        },
        "sshExplorer.statCacheTtl": {
          "type": "number",
          "default": 3000,
          "description": "%config.statCacheTtl.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "dependencies": {
    "ssh-config": "^4.4.4",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/ssh2": "^1.15.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
